# ============================================================================
# SMSAK Social Scheduler - Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# BRANDING & CONFIGURATION
# ============================================================================
SMSAK_BRAND_NAME=SMSAK Social Scheduler
SMSAK_BRAND_COLOR_PRIMARY=#00318A
SMSAK_BRAND_COLOR_ACCENT=#F5C000
SMSAK_WEBSITE=https://www.smsak.be
SMSAK_EMAIL=social@smsak.be
SMSAK_PHONE=+32 467 01 04 68
SMSAK_KBO=BE1035.506.672
SMSAK_ADDRESS=Bosheide 9, 8660 Adinkerke, Belgium

# ============================================================================
# DATABASE (REQUIRED)
# ============================================================================
# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postiz:securepass@localhost:5432/postiz_smsak
# For Vercel Postgres, the connection string is auto-provided
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# REDIS (REQUIRED)
# ============================================================================
# Redis Connection String
# Format: redis://[:password@]host:port
# Example: redis://default:password@localhost:6379
# For Vercel KV: redis://default:password@host:port
REDIS_URL=redis://user:password@host:port

# ============================================================================
# AUTHENTICATION (REQUIRED - Generate with openssl rand -base64 32)
# ============================================================================
# JWT Secret Key (used for token signing)
JWT_SECRET=generate-with-openssl-rand-base64-32

# Encryption Secret (used for encrypting sensitive data)
ENCRYPTION_SECRET=generate-with-openssl-rand-base64-32

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=production
# Options: production, development, staging

# ============================================================================
# API & HOSTING
# ============================================================================
# Your Vercel or self-hosted domain
API_URL=https://postiz-smsak.vercel.app
FRONTEND_URL=https://postiz-smsak.vercel.app

# ============================================================================
# SOCIAL PLATFORM API KEYS
# ============================================================================

# TWITTER/X
# Get from: https://developer.twitter.com/en/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LINKEDIN
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# INSTAGRAM
# Get from: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# FACEBOOK
# Get from: https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# TIKTOK
# Get from: https://developer.tiktok.com/
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# LINKEDIN (Personal)
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_PERSONAL_ACCESS_TOKEN=

# BLUESKY
# Get from: https://bsky.app/
BLUESKY_HANDLE=
BLUESKY_PASSWORD=

# MASTODON
# Get from: your-mastodon-instance/settings/applications
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=

# DISCORD
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# REDDIT
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=

# YOUTUBE
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# THREADS
# Get from: https://developers.facebook.com/
THREADS_ACCESS_TOKEN=

# GITHUB
# Get from: https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================
# Resend (Email Service)
# Get from: https://resend.com/
RESEND_API_KEY=

# SendGrid (Alternative Email Service)
# Get from: https://sendgrid.com/
SENDGRID_API_KEY=

# SMTP (Self-hosted email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smsak.be

# ============================================================================
# PAYMENTS (OPTIONAL - For Premium Features)
# ============================================================================
# Mollie
# Get from: https://www.mollie.com/
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Stripe (Alternative)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# STORAGE & UPLOADS
# ============================================================================
# AWS S3 (for storing images, videos)
# Get from: https://aws.amazon.com/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=postiz-smsak-uploads

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# ANALYTICS & MONITORING (OPTIONAL)
# ============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=

# Google Analytics
GOOGLE_ANALYTICS_ID=

# ============================================================================
# TEMPORAL (OPTIONAL - Only if using Postiz v2.12+)
# ============================================================================
# Temporal Workflow Orchestration
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default

# ============================================================================
# AI INTEGRATIONS (OPTIONAL - For AI Content Generation)
# ============================================================================
# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features (true/false)
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_ANALYTICS=true
ENABLE_TEAM_COLLABORATION=true
ENABLE_MARKETPLACE=false
ENABLE_PREMIUM_FEATURES=true

# ============================================================================
# DEVELOPMENT ONLY (Do not use in production)
# ============================================================================
# DEBUG=false
# LOG_LEVEL=info
# MOCK_SOCIAL_PLATFORMS=false
